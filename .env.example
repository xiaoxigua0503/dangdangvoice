DATABASE_URL=postgresql://dangdangvoice:local-development-only@127.0.0.1:5432/dangdangvoice
APP_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# SMTP is the normal transport. For explicit development capture only, set MAIL_TRANSPORT=capture.
MAIL_TRANSPORT=smtp
# Optional development-only .json email files (contain private links).
MAIL_CAPTURE_DIR=.dev-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Only enable behind a trusted proxy which replaces X-Forwarded-For.
TRUST_PROXY=false
# Optional owner restriction for live collection only (not a user login).
DDV_ACCESS_PASSPHRASE=

# Pro AI: server/worker only. No VITE_ prefix. No paid requests without a worker.
AI_PROVIDER=qwen
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen3.7-flash
AI_REQUEST_TIMEOUT_MS=120000
# Local worker parallelism; the DB-wide ceiling is configured with ai-admin concurrency.
AI_MAX_CONCURRENCY=2
# Legacy AI_BATCH_* settings are ignored by product-summary-v4.
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_ATTEMPTS=3
AI_MAX_RETRY_ROUNDS=2
AI_USER_MAX_ACTIVE_JOBS=2
AI_USER_MAX_DAILY_JOBS=10
AI_MAX_COMMENTS=20000
AI_MAX_IMAGES=200
AI_MAX_UNITS=2000
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_TOTAL_IMAGE_BYTES=209715200
AI_MAX_IMAGE_PIXELS=16000000

# Production daemon: direct PostgreSQL endpoint, never a PgBouncer transaction pool.
WORKER_DATABASE_URL=
# Keep false during deployment/readiness checks; enable deliberately after AI spending approval.
AI_WORKER_ENABLED=false
# Vercel only: preserve raw request bodies for the shared Node HTTP handler.
NODEJS_HELPERS=0

# Explicit read-only worker network diagnostics; off for normal operation.
AI_NETWORK_DIAGNOSTICS=false
AI_NETWORK_DIAGNOSTIC_JOB_ID=

# Ordered, server-only model allowlist. Empty = keep AI_MODEL/AI_BASE_URL/AI_API_KEY.
# Store only ENVIRONMENT VARIABLE NAMES in keyEnv, NEVER a secret value.
# See README-PRO.md for the entry format and official capacity requirements.
AI_MODELS_JSON=
# Total HTTP reservations per job, INCLUDING retries and configured fallback.
AI_MAX_PROVIDER_REQUESTS=3
AI_MODEL_COOLDOWN_SECONDS=3600
AI_MAX_RETRY_AFTER_SECONDS=120
# This flag cannot enable Aliyun's switch or query its remaining free quota.
# Enable 用完即停 in the console for EACH allowed model first.
AI_FREE_QUOTA_ONLY=false
# Single-model configuration: operator confirmation of the console setting.
AI_FREE_TIER_STOP_CONFIRMED=false
